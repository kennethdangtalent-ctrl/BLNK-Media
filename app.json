{
  "expo": {
    "name": "BLNK Media",
    "slug": "blnk-website",
    "version": "1.0.0",
    "scheme": "blnk",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#efeee9",
    "primaryColor": "#c1001f",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "name.blnk.website"
    },
    "android": {
      "package": "name.blnk.website",
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png",
      "name": "BLNK Media",
      "shortName": "BLNK",
      "themeColor": "#efeee9",
      "backgroundColor": "#efeee9"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#efeee9",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-image"
    ]
  }
}
